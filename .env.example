# ==============================================================================
# BRDS-PEC: Behavioral Ransomware Detection System - Environment Variables
# Copy this file to `.env` or set these in PowerShell ($env:VAR="value")
# ==============================================================================

# [Authentication & Security]
# Secret API key required in the 'X-BRDS-API-Key' HTTP header for live telemetry scoring
# and containment management endpoints.
BRDS_API_KEY=dev-hmac-key

# Secret cryptographic key used to sign and verify alerts in `data/processed/dry_run_alerts.json`
# and HMAC activation tokens. Must be kept confidential in production.
BRDS_ALERT_HMAC_KEY=

# In dev/evaluation environments only: set to "1" to allow fallback to an internal test key
# if BRDS_ALERT_HMAC_KEY is unset. MUST be "0" or omitted in production.
BRDS_ALLOW_INSECURE_DEV_HMAC=1

# [Containment Configuration]
# Operating mode: "0" = Dry-Run Mode (default, safe for demos & viva tests)
#                 "1" = Armed Containment Mode (executes live process termination & host isolation)
BRDS_LIVE_CONTAINMENT=0

# [ML & Anomaly Detection Tuning]
# Tier-1 Isolation Forest screening anomaly score threshold.
# Default held-out calibration: -0.167461
# Calibrated VM live candidate: -0.188196
BRDS_IF_SCREENING_THRESHOLD=-0.167461

# [Networking & CORS]
# Comma-separated list of allowed CORS origins for the SOC Dashboard API
BRDS_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# [Offline / Benchmark Mode]
# Set to "1" to serve historical benchmark datasets from CSV/JSON instead of live SQLite DB
BRDS_USE_OFFLINE_BENCHMARK=0

# [Flask Runtime]
# Set to "1" only during local development
FLASK_DEBUG=0
