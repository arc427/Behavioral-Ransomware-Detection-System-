# BRDS-PEC Configuration Template
# Copy this file to '.env' and fill in your values for your environment.

# ==============================================================================
# 1. API & HMAC AUTHENTICATION (Mandatory for Ingestion & Alert Signing)
# ==============================================================================

# API Authentication key for live telemetry ingestion (/api/score/live) and status (/api/containment/status)
# Production fails closed if missing. Set to a strong random token.
BRDS_API_KEY=replace-with-local-secret-api-key

# Secret key used to sign and verify HMAC-SHA256 signatures for alerts and arm tokens.
# Required before signing alerts or generating/verifying arm tokens.
BRDS_ALERT_HMAC_KEY=replace-with-local-secret-hmac-key

# Permitted cross-origin hosts allowed to read the Flask API (comma-separated list)
BRDS_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Flask debug mode: Set to 1 for development, 0 for production
FLASK_DEBUG=0

# ==============================================================================
# 2. CONTAINMENT SAFETY & AUTHORIZATION GATES (Default: Safe Dry-Run Mode)
# ==============================================================================
# By default, containment runs in DRY-RUN mode (-DryRunOverride passed to PowerShell).
# Live process termination and network isolation WILL NOT EXECUTE unless ALL THREE
# gates below are satisfied simultaneously:
#
#   Gate 1: Approved Lab Environment flag set:
#           BRDS_LAB_ENVIRONMENT_APPROVED=1
#
#   Gate 2: Explicit Live Containment activation flag set:
#           BRDS_LIVE_CONTAINMENT=1
#
#   Gate 3: Valid HMAC-signed activation token present at containment/.arm_token:
#           Generated via: python containment/trigger_daemon.py --create-arm-token
#
# Default values below ensure strictly safe, non-destructive dry-run execution:
BRDS_LAB_ENVIRONMENT_APPROVED=0
BRDS_LIVE_CONTAINMENT=0

# Legacy compatibility note:
# BRDS_DRY_RUN is maintained for legacy script compatibility (1=dry-run, 0=live),
# but the primary multi-gate enforcement is governed by the 3 gates above.
BRDS_DRY_RUN=1

# ==============================================================================
# 3. MACHINE LEARNING & PIPELINE THRESHOLDS (Optional overrides)
# ==============================================================================
# Isolation Forest Continuous Screening Threshold candidate:
BRDS_IF_SCREENING_THRESHOLD=-0.188196

