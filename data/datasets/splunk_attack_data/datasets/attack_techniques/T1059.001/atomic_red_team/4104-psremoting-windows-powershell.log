<Event xmlns='http://schemas.microsoft.com/win/2004/08/events/event'><System><Provider Name='Microsoft-Windows-PowerShell' Guid='{A0C1853B-5C40-4B15-8766-3CF1C58F985A}'/><EventID>4104</EventID><Version>1</Version><Level>5</Level><Task>2</Task><Opcode>15</Opcode><Keywords>0x0</Keywords><TimeCreated SystemTime='2023-03-20T12:31:36.697025100Z'/><EventRecordID>699664</EventRecordID><Correlation ActivityID='{2E415885-5754-0000-BE51-472E5457D901}'/><Execution ProcessID='5832' ThreadID='6008'/><Channel>Microsoft-Windows-PowerShell/Operational</Channel><Computer>mswin-dc01.attackrange.local</Computer><Security UserID='S-1-5-21-2126937381-3842905909-1636914737-500'/></System><EventData><Data Name='MessageNumber'>1</Data><Data Name='MessageTotal'>1</Data><Data Name='ScriptBlockText'>
